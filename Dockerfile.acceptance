# syntax=docker/dockerfile:1

ARG NODE_VERSION=24
ARG UBUNTU_VERSION=24.04
FROM node:${NODE_VERSION}-bookworm-slim AS node-runtime

FROM ubuntu:${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
      ca-certificates \
      gh \
      git \
      python3 \
      unzip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && useradd --create-home --shell /bin/bash workflow

WORKDIR /workspace
COPY README.md DEVELOPMENT.md INSTALL.md RELEASING.md APPLE-RELEASE-SETUP.md USER-GUIDE.md ./
COPY cli ./cli
RUN --mount=type=cache,target=/root/.npm,sharing=locked npm ci --prefix cli
COPY .github/workflows/release-conductor.yml ./.github/workflows/release-conductor.yml
COPY .github/actions/release-conductor-record/action.yml ./.github/actions/release-conductor-record/action.yml
COPY .github/actions/pr-ci-scope/action.yml ./.github/actions/pr-ci-scope/action.yml
COPY .github/workflows/coordinated-release-prepare.yml ./.github/workflows/coordinated-release-prepare.yml
COPY .github/workflows/coordinated-release-trust-recover.yml ./.github/workflows/coordinated-release-trust-recover.yml
COPY .github/workflows/coordinated-release-finalize.yml ./.github/workflows/coordinated-release-finalize.yml
COPY .github/workflows/coordinated-release-publish.yml ./.github/workflows/coordinated-release-publish.yml
COPY .github/workflows/homebrew-cask-finalize.yml ./.github/workflows/homebrew-cask-finalize.yml
COPY .github/workflows/homebrew-cask-publish.yml ./.github/workflows/homebrew-cask-publish.yml
COPY .github/workflows/homebrew-cask-smoke.yml ./.github/workflows/homebrew-cask-smoke.yml
COPY .github/workflows/plugin-ci.yml ./.github/workflows/plugin-ci.yml
COPY plugin-src ./plugin-src
COPY docs ./docs
COPY ci ./ci
RUN chown -R workflow:workflow /workspace

USER workflow
CMD ["bash", "ci/portable-acceptance.sh"]
