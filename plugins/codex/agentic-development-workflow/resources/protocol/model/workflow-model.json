        "locked": false,
        "enabledByDefault": true,
        "waiverAllowed": false,
        "evidence": {"kind": "reference", "requiredFor": ["PASS", "FAIL"]},
        "fingerprint": {"kind": "boundary-gate-v1", "dependencyBinding": "event-ids"},
        "boundary": {
          "gateId": "explainDiff",
          "evaluationScope": {"SLICE": "SLICE", "FEATURE_FINAL": "SLICE"},
          "guards": ["boundary.context.current"]
        },
        "run": {"kind": "skill", "skillId": "agentic-development-workflow:explain-diff"}
      },
      {
        "schemaVersion": 1,
        "id": "gatereeve/packet-validation",
        "version": "1.0.0",
        "digest": "sha256:fee6b0c16ed043cd136e63612da57addb210f9785e661c8cacb47a22247c3ef9",
        "label": "Packet Validation",
