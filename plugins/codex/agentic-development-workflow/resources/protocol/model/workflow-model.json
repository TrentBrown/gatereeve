        "locked": true,
        "enabledByDefault": true,
        "waiverAllowed": false,
        "evidence": {"kind": "reference", "requiredFor": ["PASS", "FAIL"]},
        "fingerprint": {"kind": "boundary-gate-v1", "dependencyBinding": "event-ids"},
        "boundary": {
          "gateId": "decisionTriage",
          "evaluationScope": {"SLICE": "SLICE", "FEATURE_FINAL": "SLICE"},
          "guards": ["boundary.requiredGates.current"]
        },
        "run": {"kind": "skill", "skillId": "agentic-development-workflow:workflow-decision-triage"}
      },
      {
        "schemaVersion": 1,
        "id": "gatereeve/explain-diff",
        "version": "1.0.0",
