        "waiverAllowed": true,
        "evidence": {"kind": "reference", "requiredFor": ["PASS", "FAIL"]},
        "fingerprint": {"kind": "boundary-gate-v1", "dependencyBinding": "event-ids"},
        "boundary": {
          "gateId": "patternReview",
          "evaluationScope": {"SLICE": "SLICE", "FEATURE_FINAL": "SLICE"},
          "guards": ["boundary.context.current"]
        },
        "run": {"kind": "skill", "skillId": "agentic-development-workflow:pattern-review"}
      },
      {
        "schemaVersion": 1,
        "id": "gatereeve/judge",
        "version": "1.0.0",
        "digest": "sha256:6573e9ba2b3f3c6fdf186624b3764e56bcbe9885e10a80f86eff27bc182328d4",
        "label": "Judge",
        "description": "Performs an independent compliance evaluation against the approved scope.",
        "slot": "boundary.evaluation",
        "dependsOn": ["gatereeve/verification"],
        "disposition": "required",
        "locked": false,
        "enabledByDefault": true,
        "waiverAllowed": true,
        "evidence": {"kind": "reference", "requiredFor": ["PASS", "FAIL"]},
        "fingerprint": {"kind": "boundary-gate-v1", "dependencyBinding": "event-ids"},
        "boundary": {
          "gateId": "judge",
          "evaluationScope": {"SLICE": "SLICE", "FEATURE_FINAL": "FEATURE"},
          "guards": ["boundary.context.current"]
        },
        "run": {"kind": "skill", "skillId": "agentic-development-workflow:workflow-judge"}
      },
      {
        "schemaVersion": 1,
        "id": "gatereeve/code-review",
        "version": "1.0.0",
        "digest": "sha256:a47a11a9936f1a1d90912d91a91198511ec1a75bd687880395bb092997fd0151",
        "label": "Code Review",
        "description": "Reviews the pinned change for defects, regressions, security risks, and test gaps.",
        "slot": "boundary.evaluation",
        "dependsOn": ["gatereeve/verification"],
        "disposition": "required",
        "locked": false,
        "enabledByDefault": true,
        "waiverAllowed": true,
        "evidence": {"kind": "reference", "requiredFor": ["PASS", "FAIL"]},
        "fingerprint": {"kind": "boundary-gate-v1", "dependencyBinding": "event-ids"},
        "boundary": {
          "gateId": "codeReview",
          "evaluationScope": {"SLICE": "SLICE", "FEATURE_FINAL": "SLICE"},
          "guards": ["boundary.context.current"]
        },
        "run": {"kind": "skill", "skillId": "agentic-development-workflow:workflow-pr-review"}
      },
      {
        "schemaVersion": 1,
