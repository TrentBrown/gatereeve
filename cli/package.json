{
  "name": "@quality-code/gatereeve",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Optional workflow protocol observer and enforcer for GateReeve",
  "bin": {
    "gatereeve": "./bin/workflow.js"
  },
  "files": [
    "bin/",
    "src/",
    "resources/",
    "scripts/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node bin/workflow.js",
    "test": "node --test",
    "build:plugins": "node bin/workflow.js plugin build",
    "stage:protocol": "node scripts/stage-protocol.js",
    "prepack": "npm run stage:protocol"
  },
  "dependencies": {
    "commander": "11.1.0"
  }
}
