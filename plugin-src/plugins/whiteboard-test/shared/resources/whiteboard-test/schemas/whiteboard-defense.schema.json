{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "kind", "module", "source", "outcome", "summary", "substantive", "artifactDeficiencies", "validation", "files", "receipts"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "whiteboard-defense"},
    "module": {"type": "object"},
    "source": {"type": "object"},
    "outcome": {"enum": ["PASS", "FAIL"]},
    "summary": {"type": "string", "minLength": 1},
    "substantive": {"type": "boolean"},
    "artifactDeficiencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "validation": {
      "type": "object",
      "required": ["schemaVersion", "validator", "result", "checks", "inputDigest", "errors"],
      "properties": {
        "schemaVersion": {"type": "integer", "const": 1},
        "validator": {"type": "string", "const": "whiteboard-test/deterministic-v1"},
        "result": {"enum": ["PASS", "FAIL"]},
        "checks": {"type": "array", "minItems": 7, "items": {"type": "string", "minLength": 1}},
        "inputDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "errors": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "files": {"type": "object"},
    "receipts": {"type": "array", "minItems": 2}
  },
  "additionalProperties": false
}
