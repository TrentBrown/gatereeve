{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "verdict", "summary", "criteria", "scopeCheck", "gapCheck", "contradictionCheck", "findings", "markdown"],
  "properties": {
    "schemaVersion": {"const": 1},
    "verdict": {"enum": ["PASS", "FAIL"]},
    "summary": {"type": "string", "minLength": 1},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "result", "explanation", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "result": {"enum": ["PASS", "FAIL"]},
          "explanation": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "scopeCheck": {
      "type": "object",
      "required": ["result", "explanation", "evidence"],
      "properties": {
        "result": {"enum": ["PASS", "FAIL"]},
        "explanation": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "gapCheck": {
      "type": "object",
      "required": ["result", "explanation", "evidence"],
      "properties": {
        "result": {"enum": ["PASS", "FAIL"]},
        "explanation": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "contradictionCheck": {
      "type": "object",
      "required": ["result", "explanation", "evidence"],
      "properties": {
        "result": {"enum": ["PASS", "FAIL"]},
        "explanation": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "summary", "evidence"],
        "properties": {
          "severity": {"enum": ["concern", "info"]},
          "summary": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "markdown": {"type": "string", "minLength": 128}
  },
  "additionalProperties": false
}
