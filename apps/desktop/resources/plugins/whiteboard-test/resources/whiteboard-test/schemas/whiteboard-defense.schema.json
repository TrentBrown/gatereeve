{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "kind", "module", "source", "outcome", "summary", "substantive", "artifactDeficiencies", "files", "receipts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "whiteboard-defense"},
    "module": {"type": "object"},
    "source": {"type": "object"},
    "outcome": {"enum": ["PASS", "FAIL"]},
    "summary": {"type": "string", "minLength": 1},
    "substantive": {"type": "boolean"},
    "artifactDeficiencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "files": {"type": "object"},
    "receipts": {"type": "array", "minItems": 2}
  },
  "additionalProperties": false
}
