{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["initial", "dependencies"],
  "properties": {
    "initial": {
      "type": "object",
      "required": [
        "change",
        "fullVerification",
        "fastFocusedEvidence",
        "priorFindings"
      ],
      "properties": {
        "change": {
          "type": "object",
          "required": [
            "schemaVersion",
            "source",
            "scope",
            "changedFiles",
            "sliceChangedFiles",
            "inventory",
            "sliceInventory",
            "patch",
            "slicePatch",
            "documents",
            "reviewView",
            "criteria"
          ],
          "properties": {
            "schemaVersion": {
              "const": 2
            },
            "source": {
              "type": "object",
              "required": ["baseSha", "headSha", "sliceBaseSha"]
            },
            "scope": {
              "enum": ["SLICE", "FEATURE"]
            },
            "changedFiles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sliceChangedFiles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "inventory": {
              "type": "object",
              "required": ["kind", "path", "hash", "bytes"],
              "properties": {
                "kind": {
                  "const": "snapshot-file"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "format": {
                  "const": "patch-index-v1"
                },
                "materialHash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "materialBytes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "sliceInventory": {
              "type": "object",
              "required": ["kind", "path", "hash", "bytes"],
              "properties": {
                "kind": {
                  "const": "snapshot-file"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "format": {
                  "const": "patch-index-v1"
                },
                "materialHash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "materialBytes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "patch": {
              "type": "object",
              "required": ["kind", "path", "hash", "bytes"],
              "properties": {
                "kind": {
                  "const": "snapshot-file"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "format": {
                  "const": "patch-index-v1"
                },
                "materialHash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "materialBytes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "slicePatch": {
              "type": "object",
              "required": ["kind", "path", "hash", "bytes"],
              "properties": {
                "kind": {
                  "const": "snapshot-file"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "format": {
                  "const": "patch-index-v1"
                },
                "materialHash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "materialBytes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "slicePatchSameAsFeature": {
              "type": "boolean"
            },
            "documents": {
              "type": "object",
              "required": ["spec.md", "design.md"],
              "properties": {
                "spec.md": {
                  "type": "object",
                  "required": ["kind", "path", "hash", "bytes"],
                  "properties": {
                    "kind": {
                      "const": "snapshot-file"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "format": {
                      "const": "patch-index-v1"
                    },
                    "materialHash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "materialBytes": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                },
                "design.md": {
                  "type": "object",
                  "required": ["kind", "path", "hash", "bytes"],
                  "properties": {
                    "kind": {
                      "const": "snapshot-file"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "format": {
                      "const": "patch-index-v1"
                    },
                    "materialHash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "materialBytes": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "reviewView": {
              "type": "object",
              "required": [
                "policy",
                "inputIdentity",
                "sourceTree",
                "filteredTreeDigest"
              ],
              "properties": {
                "policy": {
                  "type": "object",
                  "required": ["kind", "history"],
                  "properties": {
                    "kind": {
                      "const": "compact-review-v1"
                    },
                    "history": {
                      "const": "exclude"
                    }
                  },
                  "additionalProperties": false
                },
                "inputIdentity": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "sourceTree": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40,64}$"
                },
                "filteredTreeDigest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            },
            "criteria": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^R[0-9]+$"
              }
            }
          },
          "additionalProperties": false
        },
        "fullVerification": {
          "type": "string",
          "const": "PENDING"
        },
        "fastFocusedEvidence": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object"
          }
        },
        "priorFindings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "dependencies": {
      "type": "object",
      "maxProperties": 0
    }
  },
  "additionalProperties": false
}
